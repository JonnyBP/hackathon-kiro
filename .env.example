# Copy to .env.local and fill in. Never commit the filled file.
# .env.local is gitignored; this example file is not.

# ─── LLM provider ────────────────────────────────────────────────────────────
# "openai" (default) or "bedrock". Anything else falls back to openai.
LLM_PROVIDER=bedrock

# Optional. Overrides the provider default model id.
#   openai default:  gpt-4o
#   bedrock default: amazon.nova-lite-v1:0
# LLM_MODEL=amazon.nova-lite-v1:0

# ─── Amazon Bedrock ──────────────────────────────────────────────────────────
# Required when LLM_PROVIDER=bedrock.
# The region must be one where the model you chose is available AND where your
# account has been granted model access (Bedrock console → Model access).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for temporary credentials (STS, SSO, assumed roles):
# AWS_SESSION_TOKEN=

# The IAM identity needs bedrock:InvokeModel on the model ARN, e.g.
#   arn:aws:bedrock:us-east-1::foundation-model/amazon.nova-lite-v1:0

# ─── OpenAI ──────────────────────────────────────────────────────────────────
# Required when LLM_PROVIDER=openai.
# OPENAI_API_KEY=

# ─── Note on the AWS MCP servers ─────────────────────────────────────────────
# The MCP servers in .kiro/settings/mcp.json run as separate processes and do
# NOT read this file. The aws-pricing server needs AWS credentials of its own,
# from either:
#   a) a shared profile:  run `aws configure` (creates ~/.aws/credentials), or
#   b) the ambient environment of the editor process, or
#   c) an "env" block in .kiro/settings/mcp.json (never commit real keys there).
# The aws-docs server needs no credentials.

# ─── Data source for the frontend ────────────────────────────────────────────
# "mock" resolves every Sección from .kiro/mocks/ WITHOUT calling any LLM, so
# the UI can be demoed with no credentials at all. Anything else uses the API.
DATA_SOURCE=mock
