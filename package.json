{
  "name": "kirospec-studio",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "demo-agent4": "tsx scripts/demo-agent4.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "demo": "npx tsx scripts/demo.ts",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --workspace vitest.workspace.ts",
    "test:node": "vitest run --workspace vitest.workspace.ts --project node",
    "test:dom": "vitest run --workspace vitest.workspace.ts --project jsdom",
    "test:watch": "vitest --workspace vitest.workspace.ts",
    "test:coverage": "vitest run --workspace vitest.workspace.ts --coverage"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "2.2.12",
    "@ai-sdk/openai": "1.3.22",
    "ai": "4.3.16",
    "next": "15.3.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "3.25.36"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.15.21",
    "@types/react": "19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "3.1.4",
    "axe-core": "4.12.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "fast-check": "3.23.2",
    "jsdom": "26.1.0",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3",
    "vitest": "3.1.4"
  }
